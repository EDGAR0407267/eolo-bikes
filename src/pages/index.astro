---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import PresentationSection from '@/components/PresentationSection.astro';
import EditorialBanner from '@/components/EditorialBanner.astro';
import ServicesSection from '@/components/ServicesSection.astro';
import ManifestoSection from '@/components/ManifestoSection.astro';
import WorkshopSection from '@/components/WorkshopSection.astro';
import RentalSection from '@/components/RentalSection.astro';
import RoutesSection from '@/components/RoutesSection.astro';
import GallerySection from '@/components/GallerySection.astro';
import ReviewsSection from '@/components/ReviewsSection.astro';
import FAQSection from '@/components/FAQSection.astro';
import CTASection from '@/components/CTASection.astro';
import ContactSection from '@/components/ContactSection.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
---

<Layout
  title="EOLO Bikes | Tienda, taller y alquiler de bicicletas en Miami Platja"
  description="EOLO Bikes en Miami Platja: venta de bicicletas, taller especializado, alquiler de bicis y accesorios para ciclistas. Servicio profesional cerca de la Costa Dorada."
  ogTitle="EOLO Bikes | Bicicletas en Miami Platja"
  ogDescription="Tienda, taller y alquiler de bicicletas en Miami Platja. Tu punto ciclista de confianza en la Costa Dorada."
>
  <Header />
  <main>
    <Hero />
    <PresentationSection />
    <EditorialBanner />
    <ServicesSection />
    <ManifestoSection />
    <WorkshopSection />
    <RentalSection />
    <RoutesSection />
    <GallerySection />
    <ReviewsSection />
    <FAQSection />
    <CTASection />
    <ContactSection />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
