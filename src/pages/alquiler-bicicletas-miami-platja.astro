---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import CTASection from '@/components/CTASection.astro';
import ContactSection from '@/components/ContactSection.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { AREA_SERVED, SITE_URL, WHATSAPP_URL } from '@/lib/constants';
import { Image } from 'astro:assets';
import rentalImage from '@/assets/images/eolo-rental.png';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Alquiler de bicicletas en Miami Platja',
  description:
    'Alquiler de bicicletas en Miami Platja por días. Explora la Costa Daurada en bicicleta con EOLO Bikes.',
  url: `${SITE_URL}/alquiler-bicicletas-miami-platja/`,
  provider: {
    '@type': 'SportingGoodsStore',
    '@id': `${SITE_URL}/#local-business`,
    name: 'EOLO Bikes',
  },
  areaServed: AREA_SERVED.map((name) => ({ '@type': 'Place', name })),
  serviceType: 'Alquiler de bicicletas',
};

const bikeTypes = [
  {
    title: 'Bicicleta de paseo',
    desc: 'Cómoda y fácil. Perfecta para las rutas costeras, el carril bici y los paseos sin prisas.',
    svg: `<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>`,
    color: '#D4B46F',
    colorBg: 'rgba(212,180,111,0.08)',
    colorBorder: 'rgba(212,180,111,0.22)',
    colorGlow: 'rgba(212,180,111,0.15)',
  },
  {
    title: 'Mountain Bike',
    desc: 'Para los caminos de interior, las rutas con desnivel y la aventura fuera del asfalto.',
    svg: `<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>`,
    color: '#8E9670',
    colorBg: 'rgba(142,150,112,0.08)',
    colorBorder: 'rgba(142,150,112,0.22)',
    colorGlow: 'rgba(142,150,112,0.15)',
  },
  {
    title: 'Bicicleta eléctrica',
    desc: 'Más kilómetros, menos esfuerzo. Ideal para rutas largas y para disfrutar sin límites.',
    svg: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
    color: '#7FD6FF',
    colorBg: 'rgba(127,214,255,0.08)',
    colorBorder: 'rgba(127,214,255,0.22)',
    colorGlow: 'rgba(127,214,255,0.15)',
  },
  {
    title: 'Familiar',
    desc: 'Sillas infantiles, remolques y bicis más pequeñas. Para disfrutar en familia desde el primer pedaleo.',
    svg: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
    color: '#00C9B1',
    colorBg: 'rgba(0,201,177,0.08)',
    colorBorder: 'rgba(0,201,177,0.22)',
    colorGlow: 'rgba(0,201,177,0.15)',
  },
];

const advantages = [
  { label: 'Bicis revisadas antes de cada alquiler', svg: `<path d="M20 6 9 17l-5-5"/>` },
  { label: 'Casco incluido siempre', svg: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>` },
  { label: 'Día completo o varios días seguidos', svg: `<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>` },
  { label: 'Recomendaciones de ruta locales incluidas', svg: `<path d="M3 11l19-9-9 19-2-8-8-2z"/>` },
  { label: 'Accesorios disponibles: luces, candados, bolsas', svg: `<rect width="16" height="10" x="2" y="7" rx="2" ry="2"/><path d="M22 11V6h-4l-1 5"/>` },
];

const routes = [
  { title: 'Miami Platja · Playa', km: '~4 km', level: 'Fácil', desc: 'Paseo por el litoral, carriles bici y acceso directo a la playa. Ideal para toda la familia.' },
  { title: 'Ruta costera a L\'Hospitalet', km: '~14 km', level: 'Media', desc: 'Recorrido por la costa con paisaje mediterráneo. Rutas señalizadas y vistas al mar.' },
  { title: 'Interior: Mont-roig i Riudecanyes', km: '~25 km', level: 'Avanzada', desc: 'Para los que buscan desnivel, silencio y paisaje de interior con recompensa garantizada.' },
];

// Tarifas de alquiler — precios reales del negocio.
// 1 día = tarifa única; 3 y 7 días = precio por día (cuanto más tiempo, mejor precio).
const pricing = [
  {
    name: 'City Bike / BTT',
    tagline: 'Cómoda y versátil. Para la costa, el carril bici, los paseos y los caminos de tierra.',
    svg: `<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>`,
    color: '#D4B46F',
    colorBg: 'rgba(212,180,111,0.07)',
    colorBorder: 'rgba(212,180,111,0.24)',
    colorGlow: 'rgba(212,180,111,0.15)',
    rates: [
      { label: '1 día', price: '15', unit: '€' },
      { label: '3 días', price: '13', unit: '€ / día' },
      { label: '7 días', price: '11', unit: '€ / día' },
    ],
    deposit: '130 €',
    depositNote: 'City Bike / BTT',
  },
  {
    name: 'Road Bike aluminio',
    tagline: 'Ligera y rápida. Para devorar kilómetros por la carretera de la Costa Daurada.',
    svg: `<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>`,
    color: '#7FD6FF',
    colorBg: 'rgba(127,214,255,0.07)',
    colorBorder: 'rgba(127,214,255,0.24)',
    colorGlow: 'rgba(127,214,255,0.15)',
    rates: [
      { label: '1 día', price: '30', unit: '€' },
      { label: '3 días', price: '26', unit: '€ / día' },
      { label: '7 días', price: '20', unit: '€ / día' },
    ],
    deposit: '300 €',
    depositNote: 'Road Bike / E-Bike',
  },
  {
    name: 'City E-Bike',
    tagline: 'Más kilómetros, menos esfuerzo. Asistencia eléctrica para llegar a todas partes.',
    svg: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
    color: '#00C9B1',
    colorBg: 'rgba(0,201,177,0.07)',
    colorBorder: 'rgba(0,201,177,0.24)',
    colorGlow: 'rgba(0,201,177,0.15)',
    rates: [
      { label: '1 día', price: '40', unit: '€' },
      { label: '3 días', price: '35', unit: '€ / día' },
      { label: '7 días', price: '30', unit: '€ / día' },
    ],
    deposit: '300 €',
    depositNote: 'Road Bike / E-Bike',
  },
];
---

<Layout
  title="Alquiler de bicicletas en Miami Platja | EOLO Bikes"
  description="Alquila bicicletas en Miami Platja con EOLO Bikes. Bicis para rutas, costa, carretera, gravel y escapadas por la zona de Tarragona."
  ogTitle="Alquiler de bicicletas Miami Platja — EOLO Bikes"
  ogDescription="Alquiler de bicicletas en Miami Platja para rutas por la costa, carretera, gravel y escapadas por Tarragona."
  schema={serviceSchema}
>
  <Header />

  <main>

    <!-- ══════════════════════════════════════════
         1. HERO — Imagen + editorial costera
    ══════════════════════════════════════════ -->
    <section class="relative isolate overflow-hidden" style="min-height: 84vh;">

      <!-- Background: rental image with coastal tone -->
      <div class="absolute -inset-4 z-0 overflow-hidden" aria-hidden="true">
        <Image
          src={rentalImage}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          draggable="false"
          widths={[640, 960, 1280, 1774]}
          sizes="100vw"
          class="h-full w-full object-cover object-center pointer-events-none select-none"
          style="transform: scale(1.05); transform-origin: center 40%;"
        />
        <!-- Cinematic overlay: warm sand tones left -->
        <div
          class="absolute inset-0"
          style="background: linear-gradient(108deg, rgba(5,7,10,0.93) 0%, rgba(8,14,20,0.78) 36%, rgba(8,14,20,0.44) 66%, rgba(5,7,10,0.65) 100%);"
        ></div>
        <!-- Bottom dark pool -->
        <div
          class="absolute inset-x-0 bottom-0 h-52"
          style="background: linear-gradient(to top, #05070A 0%, transparent 100%);"
        ></div>
      </div>

      <!-- Ambient orbs: coastal warm -->
      <div class="pointer-events-none absolute inset-0 z-[2]" aria-hidden="true">
        <div class="absolute rounded-full" style="width: 480px; height: 480px; top: -100px; right: -40px; background: radial-gradient(circle, rgba(212,180,111,0.11) 0%, transparent 70%); filter: blur(1px);"></div>
        <div class="absolute rounded-full" style="width: 320px; height: 320px; bottom: 100px; left: -60px; background: radial-gradient(circle, rgba(0,201,177,0.07) 0%, transparent 70%); filter: blur(1px);"></div>
      </div>

      <!-- Editorial word: FREE -->
      <div class="subpage-hero-word pointer-events-none absolute inset-0 z-[3] flex items-center overflow-hidden" aria-hidden="true">
        <span
          data-reveal
          data-reveal-delay="0.08"
          data-reveal-y="0"
          class="select-none font-display font-black uppercase leading-none"
          style="font-size: clamp(14vw, 20vw, 280px); color: transparent; -webkit-text-stroke: 1px rgba(212,180,111,0.11); letter-spacing: -0.04em;"
        >FREE</span>
      </div>

      <!-- Content -->
      <div
        class="relative z-10 mx-auto flex flex-col justify-center px-5 pt-28 pb-28 sm:px-8 sm:pt-36 sm:pb-32 lg:pt-44 lg:pb-36"
        style="max-width: 1200px; min-height: 84vh;"
      >
        <!-- Badge -->
        <div
          data-reveal
          data-reveal-delay="0.25"
          data-reveal-y="16"
          class="mb-6 inline-flex w-fit items-center gap-2 rounded-full border px-4 py-1.5"
          style="border-color: rgba(212,180,111,0.28); background: rgba(212,180,111,0.09); backdrop-filter: blur(12px);"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#D4B46F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="text-xs font-semibold uppercase tracking-widest text-sand">Alquiler local · Miami Platja</span>
        </div>

        <!-- Headline -->
        <h1
          data-hero-title
          class="font-display font-black uppercase leading-[0.88] tracking-tight text-cream"
          style="font-size: clamp(1.9rem, 5.2vw, 5.0rem); max-width: 13ch;"
        >
          Miami Platja<br />{' '}se disfruta<br />{' '}
          <span
            class="hero-accent-mark font-accent"
            style="color: transparent; -webkit-text-stroke: 1.2px #D4B46F; background: linear-gradient(90deg, #D4B46F, #e8cc93); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          >mejor sin motor.</span>
        </h1>

        <!-- Subtitle -->
        <p
          data-hero-subtitle
          class="mt-6 max-w-lg leading-relaxed sm:mt-7"
          style="color: rgba(201,208,214,0.72); font-size: clamp(0.9rem, 1.45vw, 1.1rem);"
        >
          Alquila una bici, sal a rodar y descubre la costa mediterránea<br class="hidden sm:block"/>
          a tu ritmo. Bicis revisadas, rutas recomendadas, sin complicaciones.
        </p>

        <!-- CTAs -->
        <div
          data-hero-buttons
          class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:gap-4"
        >
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noreferrer"
            aria-label="Reservar alquiler de bicicleta por WhatsApp"
            class="inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full px-8 text-sm font-bold text-carbon transition-all duration-300 hover:-translate-y-0.5"
            style="background: linear-gradient(90deg, #D4B46F 0%, #e8cc93 100%); box-shadow: 0 0 32px rgba(212,180,111,0.30);"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
            </svg>
            Reservar alquiler
          </a>
          <a
            href="#tipos"
            class="inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full border px-8 text-sm font-semibold text-cream backdrop-blur-sm transition-all duration-300 hover:border-cream/40 hover:bg-cream/10"
            style="border-color: rgba(245,240,230,0.2); background: rgba(245,240,230,0.05);"
          >
            Ver opciones
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Location chips -->
        <div
          data-reveal
          data-reveal-delay="1.1"
          data-reveal-y="12"
          class="mt-8 flex flex-wrap gap-3"
        >
          {['Costa Daurada', 'Rutas locales', 'Cascos incluidos', 'Alquiler por días'].map(tag => (
            <span
              class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-[10px] font-semibold uppercase tracking-wider"
              style="border-color: rgba(212,180,111,0.20); background: rgba(212,180,111,0.06); color: rgba(212,180,111,0.75);"
            >{tag}</span>
          ))}
        </div>
      </div>

      <!-- Wave: Hero → Bike Types -->
      <div class="absolute inset-x-0 bottom-0 z-20 leading-[0]" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(48px, 6vw, 80px);">
          <path d="M0,40 C360,80 720,0 1080,50 C1260,75 1380,30 1440,44 L1440,80 L0,80 Z" fill="rgba(212,180,111,0.04)"/>
          <path d="M0,56 C200,24 450,70 720,42 C960,14 1200,62 1440,36 L1440,80 L0,80 Z" fill="#05070A"/>
        </svg>
      </div>
    </section>

    <!-- ══════════════════════════════════════════
         2. TIPOS DE BICICLETA
    ══════════════════════════════════════════ -->
    <section id="tipos" class="relative scroll-mt-20 overflow-hidden py-14 sm:py-24 lg:py-32 pb-24 sm:pb-32 lg:pb-40">

      <div class="section-shell">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.3em] text-sand">Nuestras bicis</p>
          <h2 class="text-balance text-2xl font-semibold leading-tight text-cream sm:text-3xl lg:text-4xl">
            Una bici para cada plan.
          </h2>
          <p class="mt-4 text-base leading-7 text-mist/60">
            Cuéntanos qué quieres hacer y te decimos qué bici llevar.
          </p>
        </div>

        <div data-stagger class="mt-10 grid gap-4 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4">
          {bikeTypes.map((type) => (
            <article
              data-stagger-item
              class="group flex flex-col rounded-[1.75rem] border p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift"
              style={`border-color: ${type.colorBorder}; background: ${type.colorBg};`}
            >
              <span
                class="mb-5 grid size-12 place-items-center rounded-full border"
                style={`color: ${type.color}; border-color: ${type.colorBorder}; background: ${type.colorGlow};`}
              >
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={type.svg}/>
              </span>
              <h3 class="text-base font-semibold text-cream sm:text-lg">{type.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-mist/65">{type.desc}</p>
              <a
                href={WHATSAPP_URL}
                target="_blank"
                rel="noreferrer"
                class="mt-6 inline-flex items-center gap-2 text-sm font-semibold transition-all duration-300 group-hover:gap-3"
                style={`color: ${type.color};`}
              >
                Reservar
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>

      <!-- Wave: Types → Experience -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(36px, 4.5vw, 60px);">
          <path d="M0,60 L1440,0 L0,0 Z" fill="rgba(212,180,111,0.03)"/>
          <path d="M0,60 L1440,0 L1440,60 Z" fill="#071018"/>
        </svg>
      </div>
    </section>

    <!-- ══════════════════════════════════════════
         3. EXPERIENCIA EDITORIAL (banner)
    ══════════════════════════════════════════ -->
    <section
      class="relative overflow-hidden bg-[#071018] py-16 sm:py-24 lg:py-32 pb-24 sm:pb-32 lg:pb-40"
    >
      <div class="absolute inset-0 bg-soft-grid bg-[size:72px_72px] opacity-[0.09]" aria-hidden="true"></div>

      <!-- Ambient warm glows -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute left-1/4 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-25" style="background: radial-gradient(circle, rgba(212,180,111,0.08), transparent 70%);"></div>
        <div class="absolute right-0 top-0 h-[300px] w-[300px] rounded-full opacity-20" style="background: radial-gradient(circle, rgba(0,201,177,0.07), transparent 70%);"></div>
      </div>

      <div class="section-shell relative z-10">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">

          <!-- Text editorial -->
          <div data-reveal>
            <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.3em] text-sand">La experiencia</p>
            <p
              class="font-display font-black uppercase leading-[0.88] text-cream"
              style="font-size: clamp(2rem, 4.8vw, 4.5rem); letter-spacing: -0.02em;"
            >
              Rueda más.<br />{' '}
              <span style="color: transparent; -webkit-text-stroke: 1.5px #D4B46F; background: linear-gradient(90deg, #D4B46F, #e8cc93); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Preocúpate<br />{' '}menos.</span>
            </p>
            <div class="mt-7 h-px w-14 bg-gradient-to-r from-sand/50 to-transparent" aria-hidden="true"></div>
            <p class="mt-7 text-base leading-8 text-mist/65" style="max-width: 44ch;">
              Las bicis salen revisadas. El casco está incluido. Nosotros te indicamos las mejores rutas. Tú solo tienes que pedalear y disfrutar de la Costa Daurada.
            </p>
            <p class="mt-4 text-sm leading-7 text-mist/50">
              Para turistas, para locales, para familias, para ciclistas en vacaciones que traen la bici en el coche o para quien simplemente quiere explorar. EOLO tiene lo que necesitas.
            </p>
          </div>

          <!-- Advantages -->
          <div data-stagger class="flex flex-col gap-3">
            {advantages.map((adv) => (
              <div
                data-stagger-item
                class="flex items-center gap-4 rounded-2xl border border-sand/14 bg-sand/6 px-5 py-4 transition-all duration-300 hover:border-sand/30 hover:bg-sand/12"
              >
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-sand/12 text-sand border border-sand/20">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={adv.svg}/>
                </span>
                <span class="text-sm font-medium text-cream/88">{adv.label}</span>
              </div>
            ))}

            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noreferrer"
              class="mt-3 inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full px-7 text-sm font-bold text-carbon transition-all duration-300 hover:-translate-y-0.5"
              style="background: linear-gradient(90deg, #D4B46F, #e8cc93); box-shadow: 0 0 24px rgba(212,180,111,0.25);"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
              </svg>
              Consultar disponibilidad
            </a>
          </div>
        </div>
      </div>

      <!-- Wave: Experience → Routes -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(36px, 4.5vw, 60px);">
          <path d="M0,30 C240,60 480,0 720,36 C960,72 1200,12 1440,40 L1440,60 L0,60 Z" fill="rgba(212,180,111,0.03)"/>
          <path d="M0,44 C180,18 380,56 620,28 C860,0 1100,52 1340,22 L1440,16 L1440,60 L0,60 Z" fill="#05070A"/>
        </svg>
      </div>
    </section>

    <!-- ══════════════════════════════════════════
         4. RUTAS DESTACADAS
    ══════════════════════════════════════════ -->
    <section class="relative overflow-hidden py-14 sm:py-20 lg:py-28 pb-24 sm:pb-32 lg:pb-40">
      <div class="section-shell">

        <div class="mb-10 flex flex-col items-start gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
          <div>
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.3em] text-sand">Rutas recomendadas</p>
            <h2 class="text-balance text-2xl font-semibold leading-tight text-cream sm:text-3xl">
              Te decimos dónde ir.
            </h2>
          </div>
          <p class="max-w-xs text-sm leading-6 text-mist/55">
            Conocemos cada camino. Ven a la tienda y te orientamos según tu nivel y el tiempo que tienes.
          </p>
        </div>

        <div data-stagger class="grid gap-4 sm:grid-cols-3">
          {routes.map((route, i) => (
            <article
              data-stagger-item
              class="group flex flex-col justify-between rounded-[1.5rem] border border-cream/[0.07] bg-cream/[0.04] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-sand/25 hover:bg-sand/8"
            >
              <div class="mb-4 flex items-start justify-between">
                <span
                  class="text-xs font-semibold uppercase tracking-wider"
                  style="color: rgba(212,180,111,0.65);"
                >{String(i + 1).padStart(2, '0')}</span>
                <span
                  class="rounded-full border border-cream/10 px-2.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wider"
                  style={`color: ${route.level === 'Fácil' ? 'rgba(0,201,177,0.8)' : route.level === 'Media' ? 'rgba(212,180,111,0.8)' : 'rgba(127,214,255,0.8)'}; border-color: ${route.level === 'Fácil' ? 'rgba(0,201,177,0.25)' : route.level === 'Media' ? 'rgba(212,180,111,0.25)' : 'rgba(127,214,255,0.25)'};`}
                >{route.level}</span>
              </div>
              <div>
                <h3 class="text-base font-semibold text-cream">{route.title}</h3>
                <p class="mt-1 text-xs font-semibold text-sand/70">{route.km}</p>
                <p class="mt-3 text-sm leading-6 text-mist/60">{route.desc}</p>
              </div>
              <span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold text-mist/40 transition-all duration-300 group-hover:text-sand/70 group-hover:gap-3">
                Preguntar en tienda
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </span>
            </article>
          ))}
        </div>

      </div>

      <!-- Wave: Routes → CTA -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
        <svg viewBox="0 0 1440 52" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(30px, 4vw, 52px);">
          <path d="M0,52 L1440,0 L0,0 Z" fill="rgba(212,180,111,0.03)"/>
          <path d="M0,52 L1440,0 L1440,52 Z" fill="#071018"/>
        </svg>
      </div>
    </section>

    <!-- ══════════════════════════════════════════
         5. TARIFAS DE ALQUILER (panel oscuro premium)
    ══════════════════════════════════════════ -->
    <section id="tarifas" class="relative scroll-mt-20 overflow-hidden bg-[#071018] py-16 sm:py-24 lg:py-32 pb-24 sm:pb-32 lg:pb-40">
      <div class="absolute inset-0 bg-soft-grid bg-[size:72px_72px] opacity-[0.08]" aria-hidden="true"></div>

      <!-- Ambient warm glow -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute left-1/2 top-1/4 h-[460px] w-[460px] -translate-x-1/2 rounded-full opacity-25" style="background: radial-gradient(circle, rgba(212,180,111,0.08), transparent 70%);"></div>
        <div class="absolute bottom-1/4 right-0 h-[320px] w-[320px] rounded-full opacity-20" style="background: radial-gradient(circle, rgba(0,201,177,0.07), transparent 70%);"></div>
      </div>

      <div class="section-shell relative z-10">

        <!-- Header -->
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.3em] text-sand">Tarifas de alquiler</p>
          <h2 class="text-balance text-2xl font-semibold leading-tight text-cream sm:text-3xl lg:text-4xl">
            Elige tu bici. Nosotros preparamos la ruta.
          </h2>
          <p class="mt-4 text-base leading-7 text-mist/65">
            Precios por día según la duración del alquiler en Miami Platja. Cuantos más días,
            mejor tarifa. Para reservas o disponibilidad, contacta directamente con EOLO Bikes.
          </p>
        </div>

        <!-- Pricing cards -->
        <div data-stagger class="mt-10 grid gap-5 sm:mt-14 lg:grid-cols-3">
          {pricing.map((bike) => (
            <article
              data-stagger-item
              class="group flex flex-col rounded-[1.75rem] border p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lift sm:p-8"
              style={`border-color: ${bike.colorBorder}; background: ${bike.colorBg};`}
            >
              <!-- Card head: icon + name + deposit badge -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span
                    class="grid size-11 shrink-0 place-items-center rounded-full border"
                    style={`color: ${bike.color}; border-color: ${bike.colorBorder}; background: ${bike.colorGlow};`}
                  >
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={bike.svg}/>
                  </span>
                  <h3 class="text-lg font-semibold leading-tight text-cream">{bike.name}</h3>
                </div>
                <span
                  class="shrink-0 rounded-full border px-2.5 py-1 text-[0.6rem] font-semibold uppercase tracking-wider"
                  style={`color: ${bike.color}; border-color: ${bike.colorBorder}; background: ${bike.colorGlow};`}
                >Depósito {bike.deposit}</span>
              </div>

              <p class="mt-4 text-sm leading-6 text-mist/65">{bike.tagline}</p>

              <!-- Rates -->
              <dl class="mt-6 flex flex-col gap-1.5">
                {bike.rates.map((rate, i) => (
                  <div
                    class="flex items-baseline justify-between rounded-2xl border px-4 py-3 transition-colors duration-300"
                    style={
                      i === bike.rates.length - 1
                        ? `border-color: ${bike.colorBorder}; background: ${bike.colorGlow};`
                        : 'border-color: rgba(245,240,230,0.08); background: rgba(245,240,230,0.03);'
                    }
                  >
                    <dt class="flex items-center gap-2 text-sm font-medium text-cream/85">
                      {rate.label}
                      {i === bike.rates.length - 1 && (
                        <span class="text-[0.6rem] font-semibold uppercase tracking-wider" style={`color: ${bike.color};`}>Mejor precio</span>
                      )}
                    </dt>
                    <dd class="font-display text-xl font-semibold leading-none text-cream sm:text-2xl">
                      {rate.price}<span class="ml-0.5 align-baseline text-xs font-sans font-medium text-mist/55">{rate.unit}</span>
                    </dd>
                  </div>
                ))}
              </dl>

              <!-- Deposit detail -->
              <p class="mt-4 flex items-center gap-2 text-xs leading-5 text-mist/55">
                <svg class="size-3.5 shrink-0" style={`color: ${bike.color};`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                Depósito reembolsable de {bike.deposit} ({bike.depositNote}).
              </p>

              <!-- CTA -->
              <a
                href={WHATSAPP_URL}
                target="_blank"
                rel="noreferrer"
                aria-label={`Consultar disponibilidad de ${bike.name} por WhatsApp`}
                class="mt-7 inline-flex min-h-[50px] items-center justify-center gap-2.5 rounded-full px-6 text-sm font-bold text-carbon transition-all duration-300 hover:-translate-y-0.5"
                style={`background: linear-gradient(90deg, ${bike.color}, ${bike.color}); box-shadow: 0 0 24px ${bike.colorGlow};`}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
                </svg>
                Consultar disponibilidad
              </a>
            </article>
          ))}
        </div>

        <!-- Microcopy footnotes -->
        <div data-reveal class="mx-auto mt-10 max-w-3xl">
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs text-mist/50">
            {['Precios por día.', 'Tarifas sujetas a disponibilidad.', 'Para alquileres largos, consulta condiciones.', 'Reserva antes de venir para asegurar tu bici.'].map((note) => (
              <li class="flex items-center gap-1.5">
                <span class="size-1 rounded-full bg-sand/60" aria-hidden="true"></span>
                {note}
              </li>
            ))}
          </ul>

          <!-- Deposit note: ES principal + EN apoyo -->
          <p class="mt-6 text-center text-sm leading-6 text-mist/65">
            Se requiere depósito reembolsable.
            <span class="mt-0.5 block text-xs italic text-mist/40">A refundable deposit is required.</span>
          </p>
        </div>

      </div>

      <!-- Wave: Tarifas (#071018) → CTA (#05070A) -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
        <svg viewBox="0 0 1440 52" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(30px, 4vw, 52px);">
          <path d="M0,52 L1440,0 L0,0 Z" fill="rgba(127,214,255,0.03)"/>
          <path d="M0,52 L1440,0 L1440,52 Z" fill="#05070A"/>
        </svg>
      </div>
    </section>

    <CTASection />
    <ContactSection />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .font-accent {
    font-family: "Playfair Display", Georgia, serif;
  }
</style>
