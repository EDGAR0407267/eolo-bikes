---
import {
  ADDRESS,
  BUSINESS_HOURS,
  INSTAGRAM_URL,
  MAPS_URL,
  PHONE_NUMBER,
  PHONE_NUMBER_E164,
  WHATSAPP_URL,
} from '@/lib/constants';
---

<section id="contacto" class="relative scroll-mt-20 overflow-hidden bg-[#071018] py-14 sm:py-24 lg:py-32 pb-20 sm:pb-28 lg:pb-36">
  <div class="absolute inset-0 bg-soft-grid bg-[size:80px_80px] opacity-[0.1]" aria-hidden="true"></div>

  <div class="section-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-stretch">

    <!-- Info card -->
    <div
      data-reveal
      class="flex flex-col justify-between rounded-[1.5rem] border border-cream/12 bg-cream/[0.06] p-6 shadow-lift backdrop-blur-xl sm:rounded-[2rem] sm:p-7 lg:p-10"
    >
      <div>
        <h2 class="text-balance text-2xl font-semibold leading-[1.08] text-cream sm:text-3xl lg:text-4xl xl:text-5xl">
          Encuéntranos en Miami Platja
        </h2>
        <div class="mt-8 space-y-5 text-base leading-8 text-mist/78">
          <p>
            <strong class="font-semibold text-cream">EOLO Bikes</strong>
          </p>
          <p class="flex gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 size-5 shrink-0 text-sand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{ADDRESS}</span>
          </p>
          <p class="flex gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 size-5 shrink-0 text-wind" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a href={`tel:${PHONE_NUMBER_E164}`} class="hover:text-cream transition-colors">{PHONE_NUMBER}</a>
          </p>
          <p class="flex gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 size-5 shrink-0 text-wind" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
            <a href={INSTAGRAM_URL} target="_blank" rel="noreferrer" class="text-wind hover:text-cream transition-colors">@eolobikes</a>
          </p>
        </div>

        <div class="mt-8 rounded-[1.4rem] border border-cream/10 bg-[#05070A]/45 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-mist/48">Horario</p>
          <dl class="mt-4 space-y-3 text-sm">
            {BUSINESS_HOURS.map(({ label, ranges }) => (
              <div class="flex items-start justify-between gap-4 border-b border-cream/6 pb-3 last:border-b-0 last:pb-0">
                <dt class="font-semibold text-cream">{label}</dt>
                <dd class:list={[
                  'text-right',
                  ranges.length ? 'text-mist/78' : 'font-semibold text-sand',
                ]}>
                  {ranges.length
                    ? ranges.map(([opens, closes]) => `${opens}-${closes}`).join(' / ')
                    : 'Cerrado'}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noreferrer"
          aria-label="Reservar taller por WhatsApp"
          class="inline-flex min-h-12 items-center gap-2 rounded-full bg-wind px-6 text-sm font-bold text-carbon transition-all duration-300 hover:-translate-y-0.5 hover:brightness-110"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
          WhatsApp
        </a>
        <a
          href={MAPS_URL}
          target="_blank"
          rel="noreferrer"
          aria-label="Ver ubicación en Google Maps"
          class="inline-flex min-h-12 items-center gap-2 rounded-full border border-cream/20 bg-cream/8 px-6 text-sm font-semibold text-cream backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:bg-cream/14"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Ver ubicación
        </a>
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noreferrer"
          aria-label="Ver Instagram de EOLO Bikes"
          class="inline-flex min-h-12 items-center gap-2 rounded-full border border-cream/20 bg-cream/8 px-6 text-sm font-semibold text-cream backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:bg-cream/14"
        >
          Instagram
        </a>
      </div>
    </div>

    <!-- Map -->
    <div
      data-reveal
      data-reveal-delay="0.12"
      class="min-h-[22rem] overflow-hidden rounded-[1.5rem] border border-cream/12 bg-carbon shadow-lift sm:min-h-[28rem] sm:rounded-[2rem]"
    >
      <div class="relative h-full min-h-[22rem] sm:min-h-[28rem]">
        <iframe
          title="Mapa de EOLO Bikes en Miami Platja"
          src="https://www.google.com/maps?q=Av.+Barcelona+111,+Miami+Platja&output=embed"
          class="absolute inset-0 h-full w-full border-0 opacity-[0.72] grayscale"
          loading="lazy"
          fetchpriority="low"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-carbon/72 via-transparent to-carbon/20" aria-hidden="true"></div>
        <div class="absolute bottom-5 left-5 right-5 rounded-[1.4rem] border border-cream/16 bg-[#05070A] p-5 shadow-lift">
          <p class="text-sm font-semibold text-cream">Av. Barcelona 111</p>
          <p class="mt-1 text-sm text-mist/82">Miami Platja · Tarragona</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Curved wave: Contact → Footer (carbon #05070A enters from below) -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
    <svg viewBox="0 0 1440 44" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(24px, 3.5vw, 44px);">
      <path d="M0,22 C360,44 720,4 1080,30 C1260,44 1380,14 1440,20 L1440,44 L0,44 Z" fill="rgba(127,214,255,0.04)"/>
      <path d="M0,30 C240,8 480,40 720,20 C960,0 1200,36 1440,16 L1440,44 L0,44 Z" fill="#05070A"/>
    </svg>
  </div>
</section>
