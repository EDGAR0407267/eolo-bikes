---
import { INSTAGRAM_URL, NAV_LINKS, PHONE_NUMBER, PHONE_NUMBER_E164, WHATSAPP_URL } from '@/lib/constants';

const year = new Date().getFullYear();
---

<footer class="relative bg-carbon py-10 sm:py-12">
  <!-- Gradient accent line: replaces flat border-t -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-wind/18 to-transparent" aria-hidden="true"></div>
  <div class="section-shell">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">

      <!-- Brand -->
      <div class="max-w-xs">
        <a href="/" class="inline-flex items-center gap-3 group" aria-label="EOLO Bikes — inicio">
          <span class="grid size-9 place-items-center rounded-full border border-cream/14 bg-cream/8 text-wind">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>
            </svg>
          </span>
          <span class="text-lg font-bold text-cream">EOLO Bikes</span>
        </a>
        <p class="mt-3 text-sm text-mist/62">Venta · Taller · Alquiler</p>
        <p class="mt-1 text-sm text-mist/62">Av. Barcelona 111, Miami Platja</p>
        <p class="mt-1 text-sm text-mist/62">Costa Daurada · Tarragona</p>
      </div>

      <!-- Nav -->
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-mist/40">Navegación</p>
        <nav class="flex flex-col gap-3" aria-label="Pie de página">
          {NAV_LINKS.map((link) => (
            <a href={link.href} class="text-sm text-mist/68 transition-colors hover:text-cream">
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-mist/40">Contacto</p>
        <div class="flex flex-col gap-3">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noreferrer"
            aria-label="WhatsApp EOLO Bikes"
            class="inline-flex items-center gap-2 text-sm font-semibold text-cream transition-colors hover:text-wind"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-wind" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
          <a
            href={`tel:${PHONE_NUMBER_E164}`}
            aria-label="Llamar a EOLO Bikes"
            class="text-sm text-mist/68 transition-colors hover:text-cream"
          >
            {PHONE_NUMBER}
          </a>
          <a
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram de EOLO Bikes"
            class="inline-flex items-center gap-2 text-sm font-semibold text-cream transition-colors hover:text-wind"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
            @eolobikes
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col gap-3 border-t border-cream/8 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-mist/40">© {year} EOLO Bikes · Miami Platja · Tarragona</p>
      <p class="text-xs text-mist/40">Taller de bicicletas · Alquiler · Venta</p>
    </div>
  </div>
</footer>
