---
import { WHATSAPP_URL, PHONE_NUMBER_E164, INSTAGRAM_URL } from '@/lib/constants';
---

<section class="relative overflow-hidden py-16 sm:py-24 lg:py-32 pb-24 sm:pb-32 lg:pb-40">
  <div class="absolute inset-0 bg-hero-field opacity-60" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-soft-grid bg-[size:64px_64px] opacity-[0.12]" aria-hidden="true"></div>

  <div class="section-shell relative z-10 text-center">
    <div data-reveal>
      <h2 class="text-balance text-3xl font-semibold leading-[1.06] text-cream sm:text-4xl lg:text-5xl xl:text-6xl">
        ¿Listo para rodar?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-mist/78 sm:mt-5 sm:text-lg sm:leading-8">
        Consúltanos sin compromiso. Estamos en Miami Platja para ayudarte a elegir, mantener o alquilar tu bicicleta ideal.
      </p>
    </div>

    <div data-stagger class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        data-stagger-item
        href={WHATSAPP_URL}
        target="_blank"
        rel="noreferrer"
        aria-label="Contactar por WhatsApp"
        class="inline-flex min-h-13 w-full items-center justify-center gap-2.5 rounded-full bg-wind px-8 text-base font-bold text-carbon shadow-glow transition-all duration-300 hover:-translate-y-0.5 hover:brightness-110 sm:w-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>

      <a
        data-stagger-item
        href={`tel:${PHONE_NUMBER_E164}`}
        aria-label="Llamar a EOLO Bikes"
        class="inline-flex min-h-13 w-full items-center justify-center gap-2.5 rounded-full border border-cream/20 bg-cream/8 px-8 text-base font-semibold text-cream backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:border-cream/40 hover:bg-cream/14 sm:w-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Llamar ahora
      </a>

      <a
        data-stagger-item
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noreferrer"
        aria-label="Ver Instagram de EOLO Bikes"
        class="inline-flex min-h-13 w-full items-center justify-center gap-2.5 rounded-full border border-cream/20 bg-cream/8 px-8 text-base font-semibold text-cream backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:border-cream/40 hover:bg-cream/14 sm:w-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
        </svg>
        Instagram
      </a>
    </div>
  </div>

  <!-- Diagonal: CTA → Contact (#071018 rises from the right) -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
    <svg viewBox="0 0 1440 52" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(32px, 4vw, 52px);">
      <!-- Wind accent: thin band above the cut -->
      <path d="M0,52 L1440,0 L0,0 Z" fill="rgba(127,214,255,0.04)"/>
      <!-- Contact bg: rises from right (same direction as Editorial) -->
      <path d="M0,52 L1440,0 L1440,52 Z" fill="#071018"/>
    </svg>
  </div>
</section>
