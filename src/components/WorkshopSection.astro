---
import SectionTitle from './SectionTitle.astro';
import { WHATSAPP_URL, WORKSHOP_ITEMS } from '@/lib/constants';
import { Image } from 'astro:assets';
import workshopImage from '@/assets/images/eolo-workshop.jpg';

const WORKSHOP_ICONS: Record<string, string> = {
  'Revisión general':           '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  'Ajuste de cambios':          '<circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>',
  'Ajuste de frenos':           '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  'Cambio de cámaras y cubiertas': '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/>',
  'Mantenimiento de transmisión':  '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  'Puesta a punto completa':    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  'Montaje de componentes':     '<line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>',
};
---

<section id="taller" class="relative scroll-mt-20 overflow-hidden bg-[#071018] py-14 sm:py-24 lg:py-32 pb-20 sm:pb-28 lg:pb-36">
  <div class="absolute inset-0 bg-soft-grid bg-[size:72px_72px] opacity-[0.12]" aria-hidden="true"></div>

  <!-- Wave entry: Manifesto (#05070A) dips into Workshop (#071018) -->
  <div class="pointer-events-none absolute inset-x-0 top-0 z-10 leading-[0]" aria-hidden="true">
    <svg viewBox="0 0 1440 52" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(30px, 4vw, 52px);">
      <path d="M0,0 C240,52 480,0 720,36 C960,72 1200,12 1440,44 L1440,0 Z" fill="#05070A"/>
    </svg>
  </div>

  <div class="section-shell grid gap-12 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">

    <!-- Copy -->
    <div>
      <div data-reveal>
        <SectionTitle
          title="Ajuste fino, reparación y mantenimiento"
          text="Un buen taller no cambia piezas por cambiar. Detecta el problema, ajusta con precisión y devuelve sensaciones."
        />
      </div>

      <div data-stagger class="mt-9 grid gap-2.5 sm:grid-cols-2">
        {WORKSHOP_ITEMS.map((item) => (
          <div
            data-stagger-item
            class="group relative flex items-center gap-3.5 overflow-hidden rounded-2xl border border-cream/[0.08] px-4 py-3.5 transition-all duration-300 hover:border-wind/30 hover:-translate-y-0.5"
            style="background: linear-gradient(135deg, rgba(245,240,230,0.055) 0%, rgba(245,240,230,0.02) 100%); box-shadow: inset 0 1px 0 rgba(245,240,230,0.07);"
          >
            <!-- hover glow -->
            <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: radial-gradient(ellipse at left center, rgba(127,214,255,0.07) 0%, transparent 65%);" aria-hidden="true"></div>
            <!-- icon -->
            <span class="relative grid size-8 shrink-0 place-items-center rounded-xl" style="background: linear-gradient(135deg, rgba(127,214,255,0.15) 0%, rgba(127,214,255,0.06) 100%); box-shadow: inset 0 1px 0 rgba(127,214,255,0.18);">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-[15px] text-wind" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={WORKSHOP_ICONS[item] ?? '<path d="M20 6 9 17l-5-5"/>'} />
            </span>
            <span class="relative text-sm font-medium leading-snug text-cream/86">{item}</span>
          </div>
        ))}
      </div>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noreferrer"
        aria-label="Reservar revisión por WhatsApp"
        data-reveal
        class="mt-10 inline-flex min-h-12 items-center gap-2.5 rounded-full border border-wind/30 bg-wind/10 px-7 text-sm font-semibold text-cream transition-all duration-300 hover:-translate-y-0.5 hover:border-wind/60 hover:bg-wind/18"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-wind" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        Reservar revisión
      </a>
    </div>

    <!-- Image -->
    <div class="relative pb-10" data-reveal data-reveal-delay="0.1">
      <div class="glass-surface relative overflow-hidden rounded-[2rem] p-2">
        <div class="relative aspect-[16/12] overflow-hidden rounded-[1.55rem] lg:aspect-[16/11]">
          <Image
            data-parallax
            data-parallax-scale="1.08"
            src={workshopImage}
            alt="Mecánico ajustando la transmisión de una bicicleta en el taller EOLO Bikes"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            widths={[480, 768, 1120]}
            sizes="(min-width: 1024px) 52vw, calc(100vw - 2rem)"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/70 via-transparent to-transparent" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Floating badge -->
      <div class="absolute -bottom-6 left-4 right-4 flex items-center gap-4 rounded-[1.4rem] border border-wind/18 bg-carbon/82 p-5 shadow-lift backdrop-blur-xl sm:left-auto sm:right-8 sm:w-80">
        <span class="grid size-12 place-items-center rounded-full bg-wind/12 text-wind">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" x2="12" y1="2" y2="6"/><line x1="12" x2="12" y1="18" y2="22"/><line x1="4.93" x2="7.76" y1="4.93" y2="7.76"/><line x1="16.24" x2="19.07" y1="16.24" y2="19.07"/><line x1="2" x2="6" y1="12" y2="12"/><line x1="18" x2="22" y1="12" y2="12"/><line x1="4.93" x2="7.76" y1="19.07" y2="16.24"/><line x1="16.24" x2="19.07" y1="7.76" y2="4.93"/>
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-cream">Diagnóstico · Ajuste · Ruta</p>
          <p class="mt-1 text-sm leading-6 text-mist/68">Precisión antes de volver a rodar.</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Wave exit: Workshop (#071018) → Rental (body #05070A) -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
    <svg viewBox="0 0 1440 56" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="block w-full" style="height: clamp(32px, 4.5vw, 56px);">
      <path d="M0,28 C200,56 450,8 720,40 C990,72 1200,18 1440,44 L1440,56 L0,56 Z" fill="rgba(127,214,255,0.03)"/>
      <path d="M0,40 C180,16 380,56 620,28 C860,0 1100,52 1340,24 L1440,18 L1440,56 L0,56 Z" fill="#05070A"/>
    </svg>
  </div>
</section>
